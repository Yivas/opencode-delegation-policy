{
  "name": "opencode-delegation-policy",
  "version": "0.1.0-alpha.2",
  "description": "Delegation policy for OpenCode v2, with explicit roles and model selection.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yivas/opencode-delegation-policy.git"
  },
  "homepage": "https://github.com/Yivas/opencode-delegation-policy#readme",
  "bugs": {
    "url": "https://github.com/Yivas/opencode-delegation-policy/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "delegation",
    "agents"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.9.1",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
