    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@opencode/plugin": "2.0.21",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.9.1",
    "typescript": "5.9.3"
  }
}
