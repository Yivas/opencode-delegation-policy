{
  "name": "opencode-delegation-policy",
  "private": true,
  "description": "Delegation policy for OpenCode v2, with explicit roles and model selection.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
